# Copiez ce fichier en ".env" puis remplissez les valeurs.
# LE FICHIER .env N'EST JAMAIS COMMITTE (le depot est public !).

# Domaine qui pointe vers le serveur (enregistrement DNS type A).
# Exemple : api.mondomaine.fr
DOMAIN=api.exemple.fr

# Mot de passe PostgreSQL. Generer un secret aleatoire :
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGER_MOI

# Cle admin des endpoints /admin/* (en-tete X-Admin-Key).
ADMIN_KEY=CHANGER_MOI

# Jeton d'enrolement des noeuds vendeurs (en-tete X-Node-Token ;
# cote application desktop : variable COMPUTERSHARE_NODE_TOKEN).
NODE_ENROLLMENT_TOKEN=CHANGER_MOI
